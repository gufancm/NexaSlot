# 复制本文件为 .env 后按需修改：cp .env.example .env
# 生产环境请务必替换所有 changethis 占位值

# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="NexaSlot"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# MySQL 8.4 (host port 3307 -> container 3306)
MYSQL_ROOT_PASSWORD=changethis
MYSQL_USER=nexaslot
MYSQL_PASSWORD=changethis
DATABASE_URL=mysql+pymysql://nexaslot:changethis@localhost:3307/app?charset=utf8mb4

# Redis (host port 6380 -> container 6379)
REDIS_URL=redis://localhost:6380/0

# 预约规则（可选，默认值如下）
# BOOKING_SLOT_MINUTES=30
# BOOKING_WINDOW_DAYS=14
# BOOKING_MIN_LEAD_MINUTES=15
# BOOKING_MAX_DURATION_MINUTES=240
# BOOKING_CANCEL_CUTOFF_MINUTES=30

# V2：Redis Cache-Aside、分布式限流、候补与 Outbox Worker（均可选默认值）
# CACHE_ENABLED=true
# CACHE_AVAILABILITY_TTL_SECONDS=60
# CACHE_RESOURCE_TTL_SECONDS=300
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_BOOKING_CAPACITY=10
# RATE_LIMIT_BOOKING_REFILL_PER_MINUTE=10
# RATE_LIMIT_WAITLIST_CAPACITY=10
# RATE_LIMIT_WAITLIST_REFILL_PER_MINUTE=10
# 高风险写接口在 Redis 不可用时是否拒绝请求（true=503，false=降级放行）
# RATE_LIMIT_FAIL_CLOSED_ON_WRITE=false

# 候补名额保留分钟数、Worker 轮询间隔与 Outbox 重试
# WAITLIST_OFFER_TTL_MINUTES=10
# OUTBOX_BATCH_SIZE=20
# OUTBOX_LEASE_SECONDS=60
# OUTBOX_MAX_ATTEMPTS=5
# WORKER_POLL_SECONDS=2.0

# 确定性匹配软偏好权重（容量 / 场地 / 时段）
# MATCH_WEIGHT_CAPACITY=0.5
# MATCH_WEIGHT_SITE=0.3
# MATCH_WEIGHT_WINDOW=0.2
